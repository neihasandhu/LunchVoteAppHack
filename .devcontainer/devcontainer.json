{
  "name": "Lunch Vote App",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "pnpm": true,
      "npm": true
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "hashicorp.terraform",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-docker",
        "ms-vscode.azurecli"
      ]
    }
  },
  "forwardPorts": [5173, 5000, 5001, 1433],
  "portsAttributes": {
    "5173": {
      "label": "SPA Frontend"
    },
    "5000": {
      "label": "API Backend"
    }
  },
  "postCreateCommand": "dotnet restore src/LunchVoteApi/LunchVoteApi.csproj && npm ci --prefix src/lunch-vote-spa",
  "remoteUser": "vscode"
}
